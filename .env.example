# Knowledgebases — copy to `.env` and uncomment what you need.
# `docker compose` reads this automatically; every value has a working default in
# docker-compose.yml, so an empty .env still starts the app + Ollama.

# ----------------------------------------------------------------- the app
# APP_PORT=8765
# APP_IMAGE=knowledgebases:latest
# COMPOSE_PROJECT_NAME=knowledgebases

# Client libraries baked into the app image, space-separated, matching the vector
# profiles you intend to use. Blank = embedded stores only (chroma, sqlite, hnswlib).
#   qdrant        -> qdrant-client
#   weaviate      -> weaviate-client
#   milvus        -> pymilvus
#   opensearch    -> opensearch-py
#   elasticsearch -> opensearch-py
#   pgvector      -> psycopg[binary] pgvector
#   redis         -> redis
#   typesense     -> typesense
#   mongodb       -> pymongo
# VECTOR_CLIENTS=qdrant-client

# 1 = install Docling into the app image too (heavy). Leave 0 when you run the
# docling profile instead — that is the whole point of the service.
# WITH_DOCLING=0

# ------------------------------------------------------------- embeddings
# PDFKB_EMBED_MODEL=qwen3-embedding:0.6b
# PDFKB_OLLAMA_URL=http://ollama:11434
# OLLAMA_PORT=11434

# --------------------------------------------------- extraction as a service
# Start it with:  docker compose --profile docling up -d
# PDFKB_DOCLING_URL=http://docling:5001
# DOCLING_PORT=5001
# DOCLING_LOG_LEVEL=INFO
# DOCLING_IMAGE=quay.io/docling-project/docling-serve:latest
#   smaller CPU-only build:
# DOCLING_IMAGE=quay.io/docling-project/docling-serve-cpu:latest

# --------------------------------------------- the vector store the app uses
# These make the stack declarative: the app boots already pointed at the database,
# with no clicks in Settings. Blank = the settings saved in the app's data volume.
# PDFKB_VECTOR_BACKEND=qdrant
# PDFKB_VECTOR_URL=http://qdrant:6333
# PDFKB_VECTOR_COLLECTION=pdf_chunks
#
# qdrant        : PDFKB_VECTOR_BACKEND=qdrant        PDFKB_VECTOR_URL=http://qdrant:6333
# opensearch    : PDFKB_VECTOR_BACKEND=opensearch    PDFKB_VECTOR_URL=http://opensearch:9200
# elasticsearch : PDFKB_VECTOR_BACKEND=elasticsearch PDFKB_VECTOR_URL=http://elasticsearch:9200
# weaviate      : PDFKB_VECTOR_BACKEND=weaviate      PDFKB_VECTOR_URL=http://weaviate:8080
# pgvector      : PDFKB_VECTOR_BACKEND=pgvector      PDFKB_VECTOR_URL=postgresql://postgres:knowledgebases@pgvector:5432/knowledgebases
# redis         : PDFKB_VECTOR_BACKEND=redis         PDFKB_VECTOR_URL=redis://redis:6379
# milvus        : PDFKB_VECTOR_BACKEND=milvus        PDFKB_VECTOR_URL=http://milvus:19530
# typesense     : PDFKB_VECTOR_BACKEND=typesense     PDFKB_VECTOR_URL=http://typesense:8108
# mongodb       : PDFKB_VECTOR_BACKEND=mongodb       PDFKB_VECTOR_URL=mongodb://knowledgebases:knowledgebases@mongodb:27017

# ------------------------------------------------------------------ service bits
# QDRANT_PORT=6333
# POSTGRES_PASSWORD=knowledgebases
# POSTGRES_DB=knowledgebases
# TYPESENSE_API_KEY=knowledgebases
# MONGO_USER=knowledgebases
# MONGO_PASSWORD=knowledgebases
# Mount a folder of documents for a `local` source:
# DOCS_DIR=/Users/kmail/Documents
